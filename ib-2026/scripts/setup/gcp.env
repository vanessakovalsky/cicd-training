# Parametres Google Cloud de la session (modifier ici, jamais dans les scripts).
GCP_PROJET="<PROJET_GCP>"            # identifiant du projet dedie a la session
GCP_ZONE="europe-west9-a"            # Paris ; region = zone sans le suffixe
GCP_TYPE="e2-standard-4"             # 4 vCPU, 16 Go
GCP_DISQUE_GO="50"
GCP_SOURCES_SSH="0.0.0.0/0"          # restreindre a l'IP publique du centre si connue
GCP_PREFIXE="cicd-stagiaire"         # VM : cicd-stagiaire-NN
GCP_LABEL="formation=cicd-jenkins"
