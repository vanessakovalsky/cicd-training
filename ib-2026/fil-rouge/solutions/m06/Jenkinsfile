// Pipeline FretExpress - etat fin du module 06 : qualite, rapports, artefacts versionnes.
pipeline {
    agent { label 'python' }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        REGISTRE = 'localhost:3000'
        IMAGE    = "${REGISTRE}/dev/fretexpress"
        PYPI_URL = 'http://gitea:3000/api/packages/dev/pypi'
    }

    stages {
        stage('Installation') {
            steps {
                sh '''
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --quiet -e ".[dev]"
                    rm -rf dist reports && mkdir -p reports   # aucun reste du build precedent
                '''
            }
        }
        stage('Version') {
            steps {
                script {
                    def base = sh(returnStdout: true, script: '''python3 -c "import tomllib; \
print(tomllib.load(open('pyproject.toml', 'rb'))['project']['version'])"''').trim()
                    def parties = base.tokenize('.')
                    env.VERSION = "${parties[0]}.${parties[1]}.${env.BUILD_NUMBER}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - ${env.VERSION}"
                }
                sh 'sed -i "s/^version = .*/version = \\"${VERSION}\\"/" pyproject.toml'
            }
        }
        stage('Analyse statique') {
            steps {
                sh '. .venv/bin/activate && ruff check --output-format=junit --output-file=reports/ruff.xml .'
            }
        }
        stage('Tests') {
            steps {
                sh '''
                    . .venv/bin/activate
                    pytest --junitxml=reports/junit.xml \
                           --cov=fretexpress --cov-branch --cov-report=xml:reports/coverage.xml
                '''
            }
        }
        stage('SonarQube') {
            when { environment name: 'SONARQUBE_ACTIF', value: 'oui' }
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'sonar-scanner -Dsonar.projectVersion=$VERSION'
                }
            }
        }
        stage('Quality gate') {
            when { environment name: 'SONARQUBE_ACTIF', value: 'oui' }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Build') {
            steps {
                sh '''
                    . .venv/bin/activate
                    pip wheel --quiet --no-deps -w dist .
                    docker build --quiet -t "$IMAGE:$VERSION" \
                        --label org.opencontainers.image.version="$VERSION" \
                        --label org.opencontainers.image.revision="$GIT_COMMIT" .
                '''
            }
        }
        stage('Publication') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'gitea-dev',
                        usernameVariable: 'GITEA_USER', passwordVariable: 'GITEA_TOKEN')]) {
                    sh '''
                        . .venv/bin/activate
                        twine upload --non-interactive --repository-url "$PYPI_URL" \
                            -u "$GITEA_USER" -p "$GITEA_TOKEN" dist/*.whl
                        echo "$GITEA_TOKEN" | docker login "$REGISTRE" -u "$GITEA_USER" --password-stdin
                        docker push --quiet "$IMAGE:$VERSION"
                        docker logout "$REGISTRE"
                    '''
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'reports/junit.xml, reports/ruff.xml'
            recordCoverage(tools: [[parser: 'COBERTURA', pattern: 'reports/coverage.xml']],
                           sourceDirectories: [[path: 'src']],
                           qualityGates: [[metric: 'BRANCH', threshold: 80.0,
                                           baseline: 'PROJECT', criticality: 'UNSTABLE']])
        }
        success {
            archiveArtifacts artifacts: 'dist/*.whl', fingerprint: true
        }
        failure {
            mail to: 'equipe@fretexpress.localhost',
                 subject: "ECHEC ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Pipeline en echec : ${env.BUILD_URL}console"
        }
        fixed {
            mail to: 'equipe@fretexpress.localhost',
                 subject: "REPARE ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Pipeline de nouveau au vert : ${env.BUILD_URL}"
        }
    }
}
